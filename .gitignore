# eclipse
bin
*.launch
.settings
.metadata
.classpath
.project

# idea
out
*.ipr
*.iws
*.iml
# Note: ".idea/*" not ".idea" — git cannot re-include a file inside an ignored
# *directory*, so the negation below only works if the directory itself is walked.
.idea/*
classes
# The Gradle wiring must be shared. IntelliJ has silently rewritten the Gradle
# wrapper to an incompatible version more than once; pinning the Gradle JVM and the
# "use the wrapper" setting in a tracked file is what prevents that.
!.idea/gradle.xml

# gradle
build
.gradle

# other
eclipse
run
libs

*.jks

# minecraft runtime / dev environment
crash-reports
logs
*.log

# editors
.vscode

# os cruft
.DS_Store
Thumbs.db
desktop.ini

# secrets
*.env
.env.*
*credentials*

# local-only Claude Code state
.claude/settings.local.json

# local-only agent/dev plans (kept private, not published)
docs/agent-plans/
# Python bytecode from the texture generators
__pycache__/
*.pyc
